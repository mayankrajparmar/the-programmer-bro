# Copy to .env.local for local overrides. Never commit real secrets.

# Canonical site origin. Leave unset in production (defaults to https://theprogrammerbro.in);
# set it on staging so canonical links, robots.txt and the sitemap point at staging.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch switch: "live" shows the full site, "coming-soon" shows only the coming-soon page.
# Defaults to coming-soon on Vercel production and live everywhere else.
# SITE_MODE=live

# AI News (see "AI News" in README.md). Without these, the News page shows its empty state.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser:
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_USER_ID=
# For running the news job locally (npm run news -- --dry-run):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# NEWS_MAX_ITEMS=20

# Browser tests: show sample stories (e2e/fixtures/news.json) on /news. Ignored in production.
# NEWS_FIXTURES=1
