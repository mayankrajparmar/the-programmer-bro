# Copy to .env.local for local overrides. Never commit real secrets.

# Canonical site origin. Leave unset in production (defaults to https://theprogrammerbro.in);
# set it on staging so canonical links, robots.txt and the sitemap point at staging.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch switch: "live" shows the full site, "coming-soon" shows only the coming-soon page.
# Defaults to coming-soon on Vercel production and live everywhere else.
# SITE_MODE=live
